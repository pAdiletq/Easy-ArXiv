# Placeholder values only. Never commit a populated .env or credential file.
# Optional. Search, reading and the prepared AI Quest work without these.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional ORCID OAuth application. Register this exact callback in ORCID.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://127.0.0.1:5000/

# Local server only. run.ps1 also accepts -Port.
PORT=5000

# Production: set these in Cloud Run, not in source or browser build variables.
# APP_ENV=production
# SAVED_STORE=firestore
# PUBLIC_ORIGIN=https://your-project.pages.dev
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# FIRESTORE_DATABASE=(default)
# ORCID_REDIRECT_URI=https://your-project.pages.dev/auth/callback
# AI_USER_DAILY_LIMIT=10
# AI_GLOBAL_DAILY_LIMIT=100
# Cloud Run uses its attached service identity (roles/datastore.user).
# Do not create or upload a service-account JSON key file.
# Put GOOGLE_API_KEY and ORCID_CLIENT_SECRET in Google Secret Manager and attach
# them as Cloud Run secret environment variables. Do not put them in Pages.
